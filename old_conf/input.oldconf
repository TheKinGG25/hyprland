input {
    kb_layout = us
    kb_variant =
    kb_model =
    kb_options =
    kb_rules =

    follow_mouse = 1

    sensitivity = 0 # -1.0 - 1.0, 0 means no modification.

    touchpad {
        natural_scroll = true
        scroll_factor = 1
    }
}

cursor {
    no_hardware_cursors = true
}

# See https://wiki.hypr.land/Configuring/Gestures
# gesture = fingers, direction, action, options
gesture = 3, horizontal, workspace

# Example per-device config
# See https://wiki.hypr.land/Configuring/Keywords/#per-device-input-configs for more
device {
    name = epic-mouse-v1 #does nothing now
    sensitivity = -2
}
device{
	name = asustek-computer-inc.-n-key-device-1
	enabled = false
}
device {
    name = sonix-gaming-keyboard-mouse
    enabled = false
}
device {
    name = glorious-model-i-2-wireless-consumer-control-1
    enabled = false
}

device {
    name = glorious-model-i-2-wireless-consumer-control-3
    enabled = false
}

device {
    name = sonix-gaming-keyboard-consumer-control-1
    enabled = false
}
device {
    name = glorious-model-i-2-wireless-mouse-1
    enabled = false
}
